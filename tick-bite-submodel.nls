;; This submodel evaluates tick bite risk for each turtle.
;; It is independent of main model state and requires input values.

to evaluate-tick-bite-risk [temp]
  if temp < 7 [stop]

  ask turtles [
    ;; Set exposure-level based on activity type
    if activity = 1 [ set exposure-level 0.01 ] ;; dog walking
    if activity = 2 [ set exposure-level 0.21 ] ;; gardening 
    if activity = 3 [ set exposure-level 0.02 ] ;; green maintenance
    if activity = 4 [ set exposure-level 0.16 ] ;; playing
    if activity = 5 [ set exposure-level 0.46 ] ;; walking
    if activity = 6 [ set exposure-level 0.02 ] ;; picknicking
    if activity = 7 [ set exposure-level 0.08 ] ;; work
    if activity = 8 [ set exposure-level 0.00 ] ;; indoors


    ;; Get month-risk value
    let month tick-to-month
    let month-risk 0
    if month = 1  [ set month-risk 0.002 ]
    if month = 2  [ set month-risk 0.003 ]
    if month = 3  [ set month-risk 0.017 ]
    if month = 4  [ set month-risk 0.065 ]
    if month = 5  [ set month-risk 0.141 ]
    if month = 6  [ set month-risk 0.277 ]
    if month = 7  [ set month-risk 0.264 ]
    if month = 8  [ set month-risk 0.109 ]
    if month = 9  [ set month-risk 0.055 ]
    if month = 10 [ set month-risk 0.044 ]
    if month = 11 [ set month-risk 0.013 ]
    if month = 12 [ set month-risk 0.037 ]

    
let weighted-risk-enhancers (
  (risk-factor           * 0.03) +
  (tick-density          * 0.50) +
  (patch-risk            * 0.12) +
  (exposure-level        * 0.25) +
  (month-risk            * 0.06)
)


let weighted-risk-reducers (
  ((1 - protection-level) * 0.50) +
  ((1 - awareness)        * 0.50)
)

let bite-risk weighted-risk-enhancers * weighted-risk-reducers



    ;; Stochastic infection based on bite-risk
    if random-float 1 < bite-risk [
      set bite-stat true
      ask patch-here [ set patch-bite-count patch-bite-count + 1 ]	
    ]
  ]
end
